[Unit]
Description=eomoe MoE LLM Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/eomoe
ExecStart=/opt/eomoe/eomoe --config /etc/eomoe/config.yaml serve
Restart=always
RestartSec=10
# Logs go to stderr -> journal (journalctl -u eomoe).

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
